<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#D6EFE9">

    <TextView
        android:text="Tambah Kelas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"/>

    <EditText
        android:id="@+id/editNamaKelas"
        android:hint="Nama Kelas (Contoh: A101)"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:drawablePadding="12dp"
        android:layout_marginBottom="12dp"
        android:textColorHint="#d0d0d0"
        android:textColor="@color/black"
        android:background="@drawable/edittext_bg"/>

    <EditText
        android:id="@+id/editWaktu"
        android:hint="Waktu (Contoh: 15:00 - 17:00)"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:drawablePadding="12dp"
        android:layout_marginBottom="12dp"
        android:textColorHint="#d0d0d0"
        android:textColor="@color/black"
        android:background="@drawable/edittext_bg"/>

    <Button
        android:id="@+id/btnSimpanKelas"
        android:text="Simpan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
</LinearLayout>
